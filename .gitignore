backend/database/*.db
backend/encrypted_files/*
!backend/encrypted_files/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/logs/*
!backend/logs/.gitkeep

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/

# Editor/OS files
.vscode/
.idea/
.DS_Store
Thumbs.db