# =========================================================
# ExamVault Environment & Real-World Credentials
# =========================================================

# Flask Secret Key
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-another-random-secret

# ---------------------------------------------------------
# REAL EMAIL OTP (GMAIL SMTP - 100% FREE, NO API REQUIRED)
# ---------------------------------------------------------
# Step 1: Turn on 2-Step Verification in your Google Account.
# Step 2: Search "App passwords" in Google Account settings.
# Step 3: Create an App Password (name it "ExamVault").
# Step 4: Fill in your Gmail and 16-character App Password below:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_actual_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_DEFAULT_SENDER=your_actual_email@gmail.com

# ---------------------------------------------------------
# REAL PHONE SMS OTP (FAST2SMS - FREE TRIAL FOR INDIA)
# ---------------------------------------------------------
# Step 1: Sign up at https://www.fast2sms.com (free trial credits).
# Step 2: Copy your API Key from Dev API tab and paste below:
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ---------------------------------------------------------
# ALTERNATIVE: REAL PHONE SMS OTP (TWILIO - GLOBAL)
# ---------------------------------------------------------
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ---------------------------------------------------------
# DEVELOPMENT SIMULATION HELPER
# Set to 'false' once you configure real Gmail SMTP or SMS.
# When 'true', OTP codes are also printed in terminal and on screen.
# ---------------------------------------------------------
SIMULATE_EMAIL_OTP=false
